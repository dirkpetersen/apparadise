# apparadise web app settings. Copy to .env and fill in the REQUIRED values.
# REQUIRED: left empty here; the app refuses to start until it is set.
# Default: the value here equals the default in the code (tests/web/test_config.py).
# Comments go on their own lines: systemd's EnvironmentFile treats a trailing # as part of the value.
# Quote any value containing $( ` ; && || or | (appmotel's parser skips them otherwise).

# --- Server ---
# REQUIRED by appmotel. A value below 10001 is replaced by an appmotel-assigned port on deploy.
PORT=8000
# Default
HOST=127.0.0.1
# Default
APP_NAME=apparadise
# Default. appmotel probes this path; it never touches the DB, LDAP, Harbor or Slurm.
HEALTH_CHECK_PATH=/health
# Default: debug, info, warning or error
LOG_LEVEL=info
# Default. Relative to the working directory (web/). Git-ignored.
DATA_DIR=data

# --- Sessions ---
# REQUIRED. Long random string, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Default (8 hours)
SESSION_MAX_AGE=28800
# Default. Set false only for local plain-http development.
SESSION_COOKIE_SECURE=true

# --- Active Directory (LDAPS only) ---
# REQUIRED. Comma-separated ldaps:// URLs; plain ldap:// is refused.
LDAP_URL=
# REQUIRED
LDAP_BASE_DN=
# REQUIRED. Service account used for the user search.
LDAP_BIND_DN=
# REQUIRED
LDAP_BIND_PASSWORD=
# Default. {login} is RFC 4515-escaped; matches username, email or UPN.
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2))(|(sAMAccountName={login})(mail={login})(userPrincipalName={login})))
# Default
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
# Default
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# Default
LDAP_EMAIL_ATTRIBUTE=mail
# Default (empty: every enabled directory account may sign in). Members, nested groups count. Q2.
LDAP_REQUIRED_GROUP_DN=
# REQUIRED. The RCO-Admins group: sysadmins, no build quota, see restricted software. Q1.
LDAP_ADMIN_GROUP_DN=
# Default (empty: system trust store). A missing file is fetched once at startup (trust on first use).
LDAP_CA_CERT_FILE=
# Default (empty: not pinned). SHA-256 fingerprint of the CA certificate.
LDAP_CA_SHA256=
# Default
LDAP_TLS_VERIFY=true
# Default (seconds)
LDAP_TIMEOUT=5

# --- Catalog and delivery ---
# Default. Folder of hand-maintained catalog/<name>.yml files (phase 1).
CATALOG_DIR=../catalog
# REQUIRED. Harbor host as used in image references, without https://, e.g. registry.example.org
REGISTRY_HOST=
# Default. Pre-staged read-only squashfs images on CephFS: <dir>/<target>/<name>-<version>-<target>.sqsh
SQSH_DIR=/shared/containers
# Default. Lmod MODULEPATH entry written by the module generator.
MODULE_DIR=/shared/modules/apparadise
# Default. Wrapper scripts: <dir>/<name>/<version>/<executable>
WRAPPER_DIR=/shared/apps/apparadise/bin

# --- Harbor admin API (one short-lived robot per build job) ---
# Default (empty: builders get no registry credentials; development only). https://registry.example.org
HARBOR_URL=
# Default (empty). A Harbor admin able to create system robot accounts; needed when HARBOR_URL is set.
HARBOR_USERNAME=
# Default (empty)
HARBOR_PASSWORD=
# Default (days a job robot lives at most; it is deleted when the job finishes)
HARBOR_ROBOT_DAYS=1

# --- Coordinator ---
# Default. A running build fails when its builder has been silent this many minutes.
BUILDER_STALE_MINUTES=30
