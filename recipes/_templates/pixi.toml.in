# pixi workspace for $NAME $VERSION on target $TARGET ($PLATFORM).
# conda-forge binaries are used as-is (not rebuilt per target). The builder solves once
# (pixi lock, with CONDA_OVERRIDE_CUDA) and ships that pixi.lock in the image.
# [system-requirements] is deprecated since pixi 0.71 (still read by 0.83); the new form is
# platforms = [{ platform = ..., cuda = ... }]. Switch together with the pixi pin.
[workspace]
name = "$NAME"
version = "$VERSION"
channels = ["conda-forge"]
platforms = ["$CONDA_PLATFORM"]

[system-requirements]
cuda = "$CUDA_MAJOR"

[dependencies]
$PIXI_DEPENDENCY
# Never a newer CUDA than the base image and target (containers/targets.yml): PTX from a
# newer NVRTC does not load on an older driver. Older is fine (PyTorch ships 12.9 builds).
cuda-version = "<=$CUDA_VERSION"
