# Runtime base: what every published image starts from. CUDA runtime only; the GPU
# driver comes from the host (Enroot/Pyxis hooks, NVIDIA GPU Operator on Run:ai).
#
#   podman build --platform linux/arm64 --build-arg CUDA_FULL=13.0.3 \
#     -f Containerfile.runtime -t $REGISTRY/cache/base-runtime:13.0-vr .
#
# Pin the base by digest in production builds (--build-arg BASE=...@sha256:...).
ARG CUDA_FULL=13.0.3
ARG BASE=nvcr.io/nvidia/cuda:${CUDA_FULL}-runtime-ubuntu24.04
FROM ${BASE}

ARG TARGET=rtx
LABEL org.opencontainers.image.vendor="apparadise" \
      org.opencontainers.image.description="apparadise runtime base (${TARGET})" \
      io.apparadise.target="${TARGET}"

# RDMA userspace so MPI/UCX/NCCL use InfiniBand; the host injects its provider libs.
# APT::Sandbox::User=root: apt's download helper otherwise switches to the _apt user, which
# a rootless builder with a single UID mapping (no /etc/subuid range) cannot do.
RUN printf 'APT::Sandbox::User "root";\n' > /etc/apt/apt.conf.d/00apparadise-sandbox \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates rdma-core libibverbs1 librdmacm1 ibverbs-providers \
      libnuma1 libgomp1 tini \
 && rm -rf /var/lib/apt/lists/*

ENV APPARADISE_TARGET=${TARGET} \
    LANG=C.UTF-8
