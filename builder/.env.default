# apparadise builder settings. Copy to .env and fill in the REQUIRED values.
# Comments go on their own lines (systemd EnvironmentFile).

# --- appmotel ---
# REQUIRED by appmotel; serves only /health.
PORT=8001
# Default
HOST=127.0.0.1
# Default
HEALTH_CHECK_PATH=/health
# Default
LOG_LEVEL=info
# Default. Holds the builder token (0600) after registration.
DATA_DIR=data
# Builds need far more than appmotel's 512M default (applies to every process of the app).
MEMORY_LIMIT=64G

# --- Coordinator ---
# REQUIRED. https://apparadise.example.org (plain http only for a loopback coordinator)
COORDINATOR_URL=
# REQUIRED. Lowercase, unique per builder, e.g. x86-build-01
BUILDER_NAME=
# Default (empty: this host's architecture, linux/amd64 or linux/arm64)
BUILDER_PLATFORM=
# Default. false for cloud builders: they never receive restricted builds.
BUILDER_ONPREM=true
# Default (empty). One-time token from a sysadmin, needed only for the first start.
REGISTRATION_TOKEN=
# Default (seconds between claims when the queue is empty)
POLL_INTERVAL=30
# Default (0: never). Exit after this many empty polls in a row; set for Slurm/EC2 builders.
IDLE_EXIT_POLLS=0

# --- Building ---
# REQUIRED. Registry (Zot) host, without https://
REGISTRY_HOST=
# Default
CONTAINER_TOOL=podman
# Default. Build trees on a large scratch volume, never the root filesystem. With
# TEST_MODE=slurm the GPU nodes must mount it too: Enroot reads the job's pull login there.
WORK_DIR=/scratch/apparadise
# Default: slurm (srun the smoke test on a GPU node) or none (fail closed, never publish)
TEST_MODE=slurm
# Default
TEST_PARTITION=gpu
# Default (empty: images are not signed by the builder)
SIGN_KEY=
# Default. Shared squashfs directory for `python -m apparadise_builder.stage`.
SQSH_DIR=/shared/containers
